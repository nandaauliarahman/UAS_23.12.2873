{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/((?!build/|assets/|favicon\\.ico$|robots\\.txt$|manifest\\.webmanifest$|service-worker\\.js$).*)",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}
